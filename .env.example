# Modo do LLM: vertex (projeto do time, cobra no faturamento) | gemini (GOOGLE_API_KEY, free tier 20 req/dia) | simulado (sem custo)
MODO_LLM=vertex
MODELO=gemini-3.8-flash
GOOGLE_CLOUD_PROJECT=batalha-time-11-5pyw
# Gemini 3.x na Vertex só existe em "global" (us-central1 devolve 404)
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_API_KEY=   (só para MODO_LLM=gemini; grave com gcloud secrets, nunca cole no chat)
# LLM_TIMEOUT_S=20
# LLM_MAX_RETRIES=1

# Dados: mock (data/mock/transacoes.csv) | bigquery
FONTE_DADOS=bigquery
BQ_TABELA=batalha-time-11-5pyw.hackathon_dados.extrato_sintetico

# Local com Docker (credencial do `gcloud auth application-default login`):
# docker run -p 127.0.0.1:8090:8080 --env-file .env \
#   -v ~/.config/gcloud/application_default_credentials.json:/secrets/adc.json:ro \
#   -e GOOGLE_APPLICATION_CREDENTIALS=/secrets/adc.json agente-fatura:dev
